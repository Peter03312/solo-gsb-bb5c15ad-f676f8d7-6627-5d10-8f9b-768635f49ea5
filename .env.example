# 复制为 .env 后由 docker compose 自动读取
# 对外暴露的 API 端口（容器内固定 8000）
API_PORT=8000

# PostgreSQL 配置（应用通过服务名 db 访问）
POSTGRES_USER=coldchain
POSTGRES_PASSWORD=coldchain
POSTGRES_DB=coldchain
# 调试用：把数据库 5432 发布到本机的端口；留空则不发布
POSTGRES_PORT_PUBLISH=5432

# 也可以直接指定完整连接串（留空则用上面的分项拼接）
# DATABASE_URL=postgresql://coldchain:coldchain@db:5432/coldchain
